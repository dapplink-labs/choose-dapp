pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    DOCKER_REGISTRY       = 'registry.example.com'
    IMAGE_NAME            = 'frontend'
    REGISTRY_CREDENTIALS  = 'docker-hub'
    IMAGE_TAG             = "${env.BUILD_NUMBER}-${env.GIT_COMMIT?.take(7)}"
    NODE_ENV              = 'production'
  }

  stages {
    stage('准备环境') {
      steps {
        sh 'node -v'
        sh 'npm -v'
      }
    }

    stage('安装依赖') {
      steps {
        sh 'npm ci'
      }
    }

    stage('代码检查') {
      steps {
        sh 'npm run lint'
      }
    }

    stage('单元测试') {
      steps {
        sh 'npm run test'
      }
    }

    stage('前端构建') {
      steps {
        sh 'npm run build'
      }
    }

    stage('构建镜像') {
      steps {
        script {
          docker.build("${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}")
        }
      }
    }

    stage('推送镜像') {
      steps {
        withCredentials([usernamePassword(credentialsId: REGISTRY_CREDENTIALS, usernameVariable: 'USER', passwordVariable: 'PASS')]) {
          sh "echo ${PASS} | docker login -u ${USER} --password-stdin ${DOCKER_REGISTRY}"
          sh "docker push ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
        }
      }
    }

    stage('部署生产') {
      when {
        anyOf {
          branch 'main'
          branch 'master'
        }
      }
      steps {
        sshagent(['prod-server']) {
          sh "ssh user@prod-server 'docker pull ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}'"
          sh "ssh user@prod-server 'docker stop frontend || true'"
          sh "ssh user@prod-server 'docker rm frontend || true'"
          sh "ssh user@prod-server 'docker run -d --name frontend -p 80:80 ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}'"
        }
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}